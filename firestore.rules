rules_version = '2';

// Regras do Firestore do Portão APMG (projeto Firebase próprio).
// Copie este arquivo inteiro em Firebase → Firestore Database → Regras → Publicar.
// Administrador: o mesmo e-mail de js/config.js (ADMIN_EMAILS).
service cloud.firestore {
  match /databases/{database}/documents {

    function logado() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function meuEmail() {
      return request.auth.token.email;
    }
    function admin() {
      return logado() && meuEmail() in ['otaviosilva.oe@gmail.com'];
    }
    function eu(email) {
      return logado() && meuEmail() == email;
    }
    function so(campos) {
      return request.resource.data.keys().hasOnly(campos);
    }
    function mudou(campos) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(campos);
    }

    // ================= Portão APMG (repositório portao-apmg) =================
    // Contas criadas pelo administrador dentro do app (criadoPeloAdmin) entram sem
    // confirmar o e-mail; as demais precisam ter o e-mail confirmado.
    // Papéis: sentinela (consulta e registra) e gestor (também edita cadastro,
    // agendados e lista de alerta); comando só consulta. Administrador: função admin() acima.
    function portaoConta() {
      return get(/databases/$(database)/documents/portaoAcessos/$(meuEmail())).data;
    }
    function portaoAuth() {
      return request.auth != null && request.auth.token.email is string;
    }
    function portaoLiberado() {
      return admin() || (portaoAuth()
        && exists(/databases/$(database)/documents/portaoAcessos/$(meuEmail()))
        && portaoConta().ativo == true
        && (request.auth.token.email_verified == true || portaoConta().get('criadoPeloAdmin', false) == true));
    }
    function portaoGestor() {
      return admin() || (portaoLiberado() && portaoConta().get('papel', '') == 'gestor');
    }
    // "comando" só consulta (painel e relatórios); não registra.
    function portaoRegistra() {
      return admin() || (portaoLiberado() && portaoConta().get('papel', '') != 'comando');
    }
    function portaoFotoOk(max) {
      return request.resource.data.get('foto', null) == null
        || (request.resource.data.foto is string && request.resource.data.foto.size() < max);
    }

    // Contas do Portão: cada pessoa lê só a própria; só o admin libera e define o papel.
    match /portaoAcessos/{email} {
      allow get: if admin() || (portaoAuth() && meuEmail() == email);
      allow list, write: if admin();
    }
    // Pedidos de acesso ao Portão: criados pela própria pessoa ao entrar.
    match /portaoPedidos/{email} {
      allow create: if eu(email) && so(['email', 'criadoEm']) && request.resource.data.email == email;
      allow get: if admin() || eu(email);
      allow list, delete: if admin();
    }
    // Veículos autorizados: gestor edita; sentinela só cria/renova "Visitante" (visitante rápido).
    match /portaoVeiculos/{placa} {
      allow read: if portaoLiberado();
      allow create, update: if portaoFotoOk(400000) && (portaoGestor()
        || (portaoLiberado() && request.resource.data.get('vinculo', '') == 'Visitante'
            && (resource == null || resource.data.get('vinculo', '') == 'Visitante')
            && portaoRegistra()));
      allow delete: if portaoGestor();
    }
    // Livro de entradas e saídas: todo liberado registra em nome próprio; ninguém edita.
    match /portaoRegistros/{id} {
      allow read: if portaoLiberado();
      allow create: if portaoRegistra() && portaoFotoOk(300000)
        && request.resource.data.get('fotos', []).size() <= 3
        && request.resource.data.por == meuEmail()
        && request.resource.data.ts is number
        && request.resource.data.tipo in ['entrada', 'saida', 'ocorrencia', 'ronda'];
      allow delete: if portaoGestor();
    }
    // Viaturas da APMG: gestor cadastra; a sentinela só atualiza KM e situação (saída/retorno).
    match /portaoViaturas/{id} {
      allow read: if portaoLiberado();
      allow write: if portaoGestor();
      allow update: if portaoRegistra()
        && mudou(['kmAtual', 'kmSaida', 'fora', 'foraDesde', 'motoristaAtual', 'destinoAtual', 'combSaida', 'faltandoSaida', 'ultimoCheck', 'atualizadoEm']);
    }
    // Lista de alerta e agendados: gestor edita; sentinelas consultam.
    match /portaoAlertas/{placa} {
      allow read: if portaoLiberado();
      allow write: if portaoGestor();
    }
    match /portaoAgendados/{id} {
      allow read: if portaoLiberado();
      allow write: if portaoGestor();
    }
    // Pontos de ronda (QR) e configuração do posto (vagas, intervalo de ronda): gestor edita.
    match /portaoPontos/{id} {
      allow read: if portaoLiberado();
      allow write: if portaoGestor();
    }
    match /portaoConfig/{id} {
      allow read: if portaoLiberado();
      allow write: if portaoGestor();
    }
    // ================= fim do Portão APMG =================

    // Qualquer outro caminho: bloqueado.
    match /{documento=**} {
      allow read, write: if false;
    }
  }
}
